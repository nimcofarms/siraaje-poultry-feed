generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("WORKER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions UserPermission?

  // Audit trail - records created by this user
  createdExpenses             Expense[]             @relation("ExpenseCreatedBy")
  createdConstructionExpenses ConstructionExpense[] @relation("ConstructionExpenseCreatedBy")
  createdProductExpenses      ProductExpense[]      @relation("ProductExpenseCreatedBy")
  createdPurchasedEggs        PurchasedEgg[]        @relation("PurchasedEggCreatedBy")
  createdEggSales             EggSale[]             @relation("EggSaleCreatedBy")
  createdFeeds                Feed[]                @relation("FeedCreatedBy")
  createdChickenVaccinations  ChickenVaccination[]  @relation("ChickenVaccinationCreatedBy")
  createdChickenVitamins      ChickenVitamin[]      @relation("ChickenVitaminCreatedBy")
  createdChickenCalciums      ChickenCalcium[]      @relation("ChickenCalciumCreatedBy")
  createdLiveChickenPurchases LiveChickenPurchase[] @relation("LiveChickenPurchaseCreatedBy")
  createdLiveChickenSales     LiveChickenSale[]     @relation("LiveChickenSaleCreatedBy")
  createdChickenMeatPurchases ChickenMeatPurchase[] @relation("ChickenMeatPurchaseCreatedBy")
  createdChickenMeatSales     ChickenMeatSale[]     @relation("ChickenMeatSaleCreatedBy")

  // Audit trail - records last updated by this user
  updatedExpenses             Expense[]             @relation("ExpenseUpdatedBy")
  updatedConstructionExpenses ConstructionExpense[] @relation("ConstructionExpenseUpdatedBy")
  updatedProductExpenses      ProductExpense[]      @relation("ProductExpenseUpdatedBy")
  updatedPurchasedEggs        PurchasedEgg[]        @relation("PurchasedEggUpdatedBy")
  updatedEggSales             EggSale[]             @relation("EggSaleUpdatedBy")
  updatedFeeds                Feed[]                @relation("FeedUpdatedBy")
  updatedChickenVaccinations  ChickenVaccination[]  @relation("ChickenVaccinationUpdatedBy")
  updatedChickenVitamins      ChickenVitamin[]      @relation("ChickenVitaminUpdatedBy")
  updatedChickenCalciums      ChickenCalcium[]      @relation("ChickenCalciumUpdatedBy")
  updatedLiveChickenPurchases LiveChickenPurchase[] @relation("LiveChickenPurchaseUpdatedBy")
  updatedLiveChickenSales     LiveChickenSale[]     @relation("LiveChickenSaleUpdatedBy")
  updatedChickenMeatPurchases ChickenMeatPurchase[] @relation("ChickenMeatPurchaseUpdatedBy")
  updatedChickenMeatSales     ChickenMeatSale[]     @relation("ChickenMeatSaleUpdatedBy")

  // Worker files
  workerFilesAssigned WorkerFile[] @relation("WorkerFileAssignedTo")
  workerFilesUploaded WorkerFile[] @relation("WorkerFileUploadedBy")
}

model UserPermission {
  id     String @id @default(cuid())
  userId String @unique

  // Dashboard
  dashboardView Boolean @default(false)

  // Expenses
  expensesView   Boolean @default(false)
  expensesAdd    Boolean @default(false)
  expensesEdit   Boolean @default(false)
  expensesDelete Boolean @default(false)

  // Eggs
  eggsView   Boolean @default(false)
  eggsAdd    Boolean @default(false)
  eggsEdit   Boolean @default(false)
  eggsDelete Boolean @default(false)

  // Feeds
  feedsView   Boolean @default(false)
  feedsAdd    Boolean @default(false)
  feedsEdit   Boolean @default(false)
  feedsDelete Boolean @default(false)

  // Poultry Health
  poultryHealthView   Boolean @default(false)
  poultryHealthAdd    Boolean @default(false)
  poultryHealthEdit   Boolean @default(false)
  poultryHealthDelete Boolean @default(false)

  // Chicken
  chickenView   Boolean @default(false)
  chickenAdd    Boolean @default(false)
  chickenEdit   Boolean @default(false)
  chickenDelete Boolean @default(false)

  // Monthly Accounts
  accountsView Boolean @default(false)

  // Documents
  documentsView   Boolean @default(false)
  documentsAdd    Boolean @default(false)
  documentsEdit   Boolean @default(false)
  documentsDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String   @id @default(cuid())
  category      String
  name          String
  description   String?
  date          DateTime
  purchasePlace String?
  quantity      Float?
  unit          String?
  unitPrice     Float?
  workers       Int?
  workDays      Float?
  laborCost     Float?
  amount        Float
  currency      String   @default("ETB")
  paymentMethod String?
  supplier      String?
  receiptNumber String?
  notes         String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
}

model ConstructionExpense {
  id       String   @id @default(cuid())
  date     DateTime
  location String?
  name     String
  type     String
  quantity Float
  price    Float
  total    Float
  currency String   @default("ETB")

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("ConstructionExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ConstructionExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
}

model ProductExpense {
  id        String   @id @default(cuid())
  date      DateTime
  location  String?
  name      String
  type      String
  quantity  Float
  price     Float
  transport Float    @default(0)
  total     Float
  currency  String   @default("ETB")

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("ProductExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ProductExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
}

model PurchasedEgg {
  id          String   @id @default(cuid())
  date        DateTime
  location    String
  companyName String
  quantity    Float
  price       Float
  total       Float
  currency    String   @default("ETB")

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("PurchasedEggCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("PurchasedEggUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
}

model EggSale {
  id           String   @id @default(cuid())
  date         DateTime
  customerType String?
  companyName  String
  quantity     Float
  price        Float
  total        Float
  currency     String   @default("ETB")

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("EggSaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("EggSaleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
  @@map("InternalEgg")
}

model Feed {
  id          String   @id @default(cuid())
  date        DateTime
  feedType    String
