  chickenType String
  location    String
  ageNumber   Int
  ageUnit     String
  quantity    Int
  price       Float
  total       Float
  currency    String   @default("ETB")

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("LiveChickenPurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("LiveChickenPurchaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
}

