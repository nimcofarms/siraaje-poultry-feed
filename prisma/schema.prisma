//
// WORKER FILES
//

model WorkerFile {
  id           String  @id @default(cuid())
  title        String
  description  String?
  category     String?
  fileName     String
  fileUrl      String
  blobPathname String?
  contentType  String
  size         Int?

  assignedToId String?
  uploadedById String

  assignedTo User? @relation("WorkerFileAssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("WorkerFileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([uploadedById])
  @@index([createdAt])
}

model CompanyDocument {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  category     String
  fileName     String
  fileUrl      String
  blobPathname String?
  contentType  String   @default("application/pdf")
  size         Int?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
