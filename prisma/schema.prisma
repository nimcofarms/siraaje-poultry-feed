generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("WORKER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions UserPermission?
}

model UserPermission {
  id     String @id @default(cuid())
  userId String @unique

  // Dashboard
  dashboardView Boolean @default(false)

  // Expenses
  expensesView   Boolean @default(false)
  expensesAdd    Boolean @default(false)
  expensesEdit   Boolean @default(false)
  expensesDelete Boolean @default(false)

  // Eggs
  eggsView   Boolean @default(false)
  eggsAdd    Boolean @default(false)
  eggsEdit   Boolean @default(false)
  eggsDelete Boolean @default(false)

  // Feeds
  feedsView   Boolean @default(false)
  feedsAdd    Boolean @default(false)
  feedsEdit   Boolean @default(false)
  feedsDelete Boolean @default(false)

  // Poultry Health
  poultryHealthView   Boolean @default(false)
  poultryHealthAdd    Boolean @default(false)
  poultryHealthEdit   Boolean @default(false)
  poultryHealthDelete Boolean @default(false)

  // Chicken
  chickenView   Boolean @default(false)
  chickenAdd    Boolean @default(false)
  chickenEdit   Boolean @default(false)
  chickenDelete Boolean @default(false)

  // Documents
  documentsView   Boolean @default(false)
  documentsAdd    Boolean @default(false)
  documentsEdit   Boolean @default(false)
  documentsDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String   @id @default(cuid())
  category      String
  name          String
  description   String?
  date          DateTime
  purchasePlace String?
  quantity      Float?
  unit          String?
  unitPrice     Float?
  workers       Int?
  workDays      Float?
  laborCost     Float?
  amount        Float
  currency      String   @default("ETB")
  paymentMethod String?
  supplier      String?
  receiptNumber String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ConstructionExpense {
  id        String   @id @default(cuid())
  date      DateTime
  location  String?
  name      String
  type      String
  quantity  Float
  price     Float
  total     Float
  currency  String   @default("ETB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductExpense {
  id        String   @id @default(cuid())
  date      DateTime
  location  String?
  name      String
  type      String
  quantity  Float
  price     Float
  transport Float    @default(0)
  total     Float
  currency  String   @default("ETB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchasedEgg {
  id          String   @id @default(cuid())
  date        DateTime
  location    String
  companyName String
  quantity    Float
  price       Float
  total       Float
  currency    String   @default("ETB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EggSale {
  id           String   @id @default(cuid())
  date         DateTime
  customerType String?
  companyName  String
  quantity     Float
  price        Float
  total        Float
  currency     String   @default("ETB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("InternalEgg")
}

model Feed {
  id          String   @id @default(cuid())
  date        DateTime
  feedType    String
  companyName String
  suppliedBy  String
  quantity    Float
  price       Float
  total       Float
  currency    String   @default("ETB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChickenVaccination {
  id               String   @id @default(cuid())
  date             DateTime
  stage            String
  vaccineName      String
  disease          String
  application      String
  givenBy          String
  numberOfChickens Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChickenVitamin {
  id               String   @id @default(cuid())
  date             DateTime
  vitaminName      String
  givenBy          String
  numberOfChickens Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChickenCalcium {
  id               String   @id @default(cuid())
  date             DateTime
  calciumName      String
  givenBy          String
  numberOfChickens Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

//
// CHICKEN / DIGAAG
//

// Live Chicken - Purchases
model LiveChickenPurchase {
  id          String   @id @default(cuid())
  date        DateTime
  chickenType String
  location    String
  ageNumber   Int
  ageUnit     String
  quantity    Int
  price       Float
  total       Float
  currency    String   @default("ETB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Live Chicken - Sales
model LiveChickenSale {
  id          String   @id @default(cuid())
  date        DateTime
  chickenType String
  location    String
  ageNumber   Int
  ageUnit     String
  quantity    Int
  price       Float
  total       Float
  currency    String   @default("ETB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Chicken Meat - Purchases
model ChickenMeatPurchase {
  id          String   @id @default(cuid())
  date        DateTime
  location    String
  companyName String
  quantity    Int
  price       Float
  total       Float
  currency    String   @default("ETB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Chicken Meat - Sales
model ChickenMeatSale {
  id           String   @id @default(cuid())
  date         DateTime
  location     String
  customerType String
  branch       String
  quantity     Int
  price        Float
  total        Float
  currency     String   @default("ETB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanyDocument {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  category     String
  fileName     String
  fileUrl      String
  blobPathname String?
  contentType  String   @default("application/pdf")
  size         Int?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
