  updatedAt DateTime @updatedAt

  createdBy User? @relation("ChickenCalciumCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ChickenCalciumUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

