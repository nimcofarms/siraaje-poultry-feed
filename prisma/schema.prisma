  createdBy User? @relation("ChickenMeatPurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ChickenMeatPurchaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

